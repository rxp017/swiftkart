VAR R=CALCULATETABLE(SUMMARIZE(DimStore,DimStore[StoreID],"Rank",[Store rank]),DimDate[Year]=2025)
RETURN UNION(
 ROW("Check","150 measures return values","Result",IF(COALESCE(COUNTROWS(FILTER(T,[Blank])),0)=0,"PASS",CONCATENATEX(FILTER(T,[Blank]),[Name],", "))),
 ROW("Check","2025 sales, profit and orders match CSV","Result",IF(CALCULATE(ABS([Sales]-25797405.179)<0.01 && ABS([Profit]-9776626.059)<0.01 && [Orders]=80667,DimDate[Year]=2025),"PASS","FAIL")),
 ROW("Check","Category sales sum equals Home sales","Result",IF(CALCULATE(ABS([Sales]-SUMX(VALUES(DimProduct[Category]),[Sales]))<0.01,DimDate[Year]=2025),"PASS","FAIL")),
 ROW("Check","All 60 stores have a unique rank, 1 to 60","Result",IF(MINX(R,[Rank])=1 && MAXX(R,[Rank])=60 && COUNTROWS(DISTINCT(SELECTCOLUMNS(R,"r",[Rank])))=60,"PASS","FAIL")),
 ROW("Check","Store rank is blank in the Total row","Result",IF(ISBLANK([Store rank]),"PASS","FAIL")),
 ROW("Check","Mumbai sales display as Rs 34.6 L","Result",IF(CALCULATE([City FormatINR],DimDate[Year]=2025,CurrencyScope[Kind]="Sales")="₹34.6 L","PASS","FAIL")),
 ROW("Check","Delivery and rating values are in range","Result",IF(CALCULATE([Avg delivery time]>16 && [Avg delivery time]<27 && [Rating]>=1 && [Rating]<=5,DimDate[Year]=2025),"PASS","FAIL"))
)