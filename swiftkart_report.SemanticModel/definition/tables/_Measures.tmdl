	measure 'City stores note' = FORMAT(CALCULATE(DISTINCTCOUNT(DimStore[StoreID]),TREATAS({[Chosen city]},DimStore[City])),"0")&" stores in "&[Chosen city]
		formatString: General
		displayFolder: Words
		lineageTag: ac083c4c-0b65-4de2-b17c-2ead8225abf2

	measure 'Tooltip sales' = FORMAT([Year selected],"0")&" • before returns"
