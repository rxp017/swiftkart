	measure 'Payment note' = FORMAT(DIVIDE(CALCULATE([Orders],FactSales[PaymentMode]="UPI"),[Orders]),"0%")&" of orders paid with UPI"
		formatString: General
		displayFolder: Words
		lineageTag: 1a776175-1f7a-4cef-976d-11e803b55b3e

