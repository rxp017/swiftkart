	measure Glossary =
			"Sales: order value after discounts, before returns.
			Profit: sales minus product costs, before shop expenses.
			Orders: how many purchases people made.
			Avg delivery: usual wait from order to doorstep.
			Orders returned: share sent back by customers.
			Came back: people who ordered again later."
		formatString: General
		displayFolder: Words
		lineageTag: 710fbbe1-b252-48a9-b217-019401fb33e4

