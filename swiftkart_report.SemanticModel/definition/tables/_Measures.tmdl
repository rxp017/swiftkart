table _Measures
	lineageTag: 4fb262c7-84db-4cc6-a768-bd096e948351

	measure Sales = SUM(FactSales[Revenue])
		formatString: #,0
		displayFolder: Numbers
		lineageTag: 3cd4d1f7-490f-462c-b080-849e11612c35

	measure Cost = SUM(FactSales[Cost])
		formatString: #,0
		displayFolder: Numbers
		lineageTag: 76111223-c25a-46f8-9414-34ba4c169451

	measure Profit = [Sales]-[Cost]
		formatString: #,0
		displayFolder: Numbers
		lineageTag: a319975d-07be-4c09-a41e-6ec9ad6ebdf2

	measure Orders = COUNTROWS(FactSales)
		formatString: #,0
		displayFolder: Numbers
		lineageTag: 6125be1d-c8a6-45b1-bd20-ad0cdee45def

	measure Customers = DISTINCTCOUNT(FactSales[CustomerID])
		formatString: #,0
		displayFolder: Numbers
		lineageTag: 7284d800-f995-421d-8424-60be748de802

	measure Units = SUM(FactSales[Quantity])
		formatString: #,0
		displayFolder: Numbers
		lineageTag: 876ce457-5459-4657-8bd2-3a8e7db56106

	measure 'Avg order value' = DIVIDE([Sales],[Orders])
		formatString: 0
		displayFolder: Numbers
		lineageTag: 15a0f967-2626-4973-9488-cb5c55760c3a

	measure 'Avg delivery time' = AVERAGE(FactSales[DeliveryMinutes])
		formatString: 0.0 "min"
		displayFolder: Numbers
		lineageTag: 7a907a1f-1759-4d4b-9f0d-2fb10f72a362

	measure 'Orders returned' = DIVIDE(SUM(FactSales[ReturnFlag]),[Orders])
		formatString: 0.0%
		displayFolder: Numbers
		lineageTag: a58a3b95-535a-4839-9c48-37d514a84806

	measure Rating = AVERAGE(FactSales[Rating])
		formatString: 0.00 " / 5"
		displayFolder: Numbers
		lineageTag: ddd6e922-d3a0-4438-9a26-305e203035bb

	measure Margin = DIVIDE([Profit],[Sales])
		formatString: 0.0%
		displayFolder: Numbers
		lineageTag: 6e7719ca-0577-4700-aa12-4187226c7378

	measure 'Sales last year' = CALCULATE([Sales],DATEADD(DimDate[Date],-1,YEAR))
		formatString: #,0
		displayFolder: Report
		lineageTag: bb93e062-d00d-443b-af6d-4739a69fbafc

	measure 'Sales change' = VAR P=CALCULATE([Sales],DATEADD(DimDate[Date],-1,YEAR)) RETURN DIVIDE([Sales]-P,P)
		formatString: 0.0%
		displayFolder: Compared with last year
		lineageTag: bb10197f-9abf-41ed-bd84-8db447262381

	measure 'Sales arrow' = VAR P=CALCULATE([Sales],DATEADD(DimDate[Date],-1,YEAR)) RETURN IF(ISBLANK(P),"No earlier year",IF([Sales change]>=0,"↑ ","↓ ")&FORMAT(ABS([Sales change]),"0.0%")&" vs last year")
		formatString: General
		displayFolder: Compared with last year
		lineageTag: 9023e9a3-e6ab-4940-88c4-e3d684bb269f

	measure 'Sales color' = IF([Sales change]>=0,"#158C67","#D83760")
		formatString: General
		displayFolder: Colors
		lineageTag: a1e0d70e-c5a4-480c-8d86-8c4bf21e39c5

	measure 'Profit change' = VAR P=CALCULATE([Profit],DATEADD(DimDate[Date],-1,YEAR)) RETURN DIVIDE([Profit]-P,P)
		formatString: 0.0%
		displayFolder: Compared with last year
		lineageTag: 58c94bbf-3a14-4ecd-8bf3-4792ccbba145

	measure 'Profit arrow' = VAR P=CALCULATE([Profit],DATEADD(DimDate[Date],-1,YEAR)) RETURN IF(ISBLANK(P),"No earlier year",IF([Profit change]>=0,"↑ ","↓ ")&FORMAT(ABS([Profit change]),"0.0%")&" vs last year")
		formatString: General
		displayFolder: Compared with last year
		lineageTag: 07ba71fd-b2fd-4af5-a2b3-ac26f9569691

	measure 'Profit color' = IF([Profit change]>=0,"#158C67","#D83760")
		formatString: General
		displayFolder: Colors
		lineageTag: b7bd3fc2-7ba1-4216-98e7-fe24949384e6

	measure 'Orders change' = VAR P=CALCULATE([Orders],DATEADD(DimDate[Date],-1,YEAR)) RETURN DIVIDE([Orders]-P,P)
		formatString: 0.0%
		displayFolder: Compared with last year
		lineageTag: 42a1ae45-2fc7-468a-817d-e18b3dc49881

	measure 'Orders arrow' = VAR P=CALCULATE([Orders],DATEADD(DimDate[Date],-1,YEAR)) RETURN IF(ISBLANK(P),"No earlier year",IF([Orders change]>=0,"↑ ","↓ ")&FORMAT(ABS([Orders change]),"0.0%")&" vs last year")
		formatString: General
		displayFolder: Compared with last year
		lineageTag: 55e2c190-9032-4359-a41e-e632ab5d1f7a

	measure 'Orders color' = IF([Orders change]>=0,"#158C67","#D83760")
		formatString: General
		displayFolder: Colors
		lineageTag: 4d28877b-e0d8-4766-b622-73323aa7e4ca

	measure 'Avg delivery time change' = VAR P=CALCULATE([Avg delivery time],DATEADD(DimDate[Date],-1,YEAR)) RETURN DIVIDE([Avg delivery time]-P,P)
		formatString: 0.0%
		displayFolder: Compared with last year
		lineageTag: 10af7d67-d39b-4d70-b1de-ff01bf8ecf7e

	measure 'Avg delivery time arrow' = VAR P=CALCULATE([Avg delivery time],DATEADD(DimDate[Date],-1,YEAR)) RETURN IF(ISBLANK(P),"No earlier year",IF([Avg delivery time change]>=0,"↑ ","↓ ")&FORMAT(ABS([Avg delivery time change]),"0.0%")&" vs last year")
		formatString: General
		displayFolder: Compared with last year
		lineageTag: 1b68c519-8fc4-4be3-93dd-c63128ed4382

	measure 'Avg delivery time color' = IF([Avg delivery time change]<=0,"#158C67","#D83760")
		formatString: General
		displayFolder: Colors
		lineageTag: d7140448-f73d-4639-a8a8-bd5656c08675

	measure 'Avg order value change' = VAR P=CALCULATE([Avg order value],DATEADD(DimDate[Date],-1,YEAR)) RETURN DIVIDE([Avg order value]-P,P)
		formatString: 0.0%
		displayFolder: Compared with last year
		lineageTag: d83b541c-7a9c-416d-b4fb-6d10ea85409b

	measure 'Avg order value arrow' = VAR P=CALCULATE([Avg order value],DATEADD(DimDate[Date],-1,YEAR)) RETURN IF(ISBLANK(P),"No earlier year",IF([Avg order value change]>=0,"↑ ","↓ ")&FORMAT(ABS([Avg order value change]),"0.0%")&" vs last year")
		formatString: General
		displayFolder: Compared with last year
		lineageTag: 4385113c-8f68-4476-9ea3-720038db879d

	measure 'Avg order value color' = IF([Avg order value change]>=0,"#158C67","#D83760")
		formatString: General
		displayFolder: Colors
		lineageTag: 4a46341e-c83a-41bc-81e8-d5c4ccfc7cf3

	measure 'Year selected' = SELECTEDVALUE(DimDate[Year],2025)
		formatString: 0
		displayFolder: Words
		lineageTag: 5e2257b1-0a6f-452d-948c-208c820e2f48

	measure Showing = "Showing: "&[Year selected]&IF([Year selected]=2023," • no earlier year",", compared with "&([Year selected]-1))
		formatString: General
		displayFolder: Words
		lineageTag: 2cd6c004-c3ec-4bda-a6a1-35f1f38e0ccc

	measure 'City title' = [Chosen city]&": city deep dive"
		formatString: General
		displayFolder: Words
		lineageTag: 82213d50-7de6-4f22-8a7b-44c47d20cfbb

	measure 'Metric value' = SWITCH(SWITCH(SELECTEDVALUE(Metric[Order],0),1,"Profit",2,"Orders","Sales"),"Profit",[Profit],"Orders",[Orders],[Sales])
		formatString: #,0
		displayFolder: Report
		lineageTag: 80fd681f-008d-4f4f-a468-e3cd211f0258

	measure 'Metric name' = SWITCH(SELECTEDVALUE(Metric[Order],0),1,"Profit",2,"Orders","Sales")
		formatString: General
		displayFolder: Words
		lineageTag: 515af74b-badf-4dcb-99b4-78c9a9f77129

	measure 'Metric display' = VAR K=[Metric name] RETURN IF(K="Orders",FORMAT([Orders],"#,0"),CALCULATE([FormatINR],CurrencyScope[Kind]=K))
		formatString: General
		displayFolder: Words
		lineageTag: 05c194fe-8554-4e52-81db-23e9369d50db

	measure 'Money value' = SWITCH(SELECTEDVALUE(CurrencyScope[Kind],"Sales"),"Profit",[Profit],"Avg order value",[Avg order value],[Sales])
		formatString: #,0
		displayFolder: Report
		lineageTag: 1cf5e636-601c-41e9-a2a9-86b3a7f332f2

	measure FormatINR = VAR V=[Money value] VAR A=ABS(V) RETURN SWITCH(TRUE(),A>=10000000,"₹"&FORMAT(V/10000000,"0.00")&" Cr",A>=100000,"₹"&FORMAT(V/100000,"0.0")&" L",A>=1000,"₹"&FORMAT(V/1000,"0.0")&" K","₹"&FORMAT(V,"0"))
		formatString: General
		displayFolder: Indian currency
		lineageTag: 45868dd8-5101-4404-a2a7-ad40c3947f7b

	measure 'Sales L' = [Sales]/100000
		formatString: ₹0.0 "L"
		displayFolder: Indian currency
		lineageTag: 86fbc95f-51eb-4bfc-8726-b8dd5d8d54d7

	measure 'Last year L' = [Sales last year]/100000
		formatString: ₹0.0 "L"
		displayFolder: Indian currency
		lineageTag: dbd83b09-f059-4fc6-8282-0d9027c54333

	measure 'Profit L' = [Profit]/100000
		formatString: ₹0.0 "L"
		displayFolder: Indian currency
		lineageTag: 8012a385-a715-4242-bcbe-c98d39e032ff

	measure 'Category color' = SELECTEDVALUE(DimProduct[CategoryColor],"#2EE6A6")
		formatString: General
		displayFolder: Colors
		lineageTag: 13e480d5-1026-42e2-8437-3964e447aa27

	measure 'Delivery color' = IF([Avg delivery time]>22,"#FF4D6D","#2EE6A6")
		formatString: General
		displayFolder: Colors
		lineageTag: b3ff1d46-8d05-4186-a099-922763f90067

	measure 'Return color' = VAR P=[Orders returned] RETURN SWITCH(TRUE(),P>=.10,"#FF4D6D",P>=.08,"#D64164",P>=.06,"#B63659","#8F2D4C")
		formatString: General
		displayFolder: Colors
		lineageTag: 0ae697d2-629e-48a2-8b21-a85fbb394fc7

	measure 'Store rank' = IF(ISINSCOPE(DimStore[StoreID]),RANKX(ALL(DimStore),CALCULATE([Sales]),,DESC,DENSE))
		formatString: 0
		displayFolder: Store ranking
		lineageTag: 5e29dc55-4642-4186-b645-360dd1d4180a

	measure 'Show store' = VAR R=[Store rank] RETURN IF(SELECTEDVALUE(StoreView[Choice],"Top 10")="Top 10",IF(R<=10,1,0),IF(R>50,1,0))
		formatString: 0
		displayFolder: Store ranking
		lineageTag: 5478d8fd-fb4b-460b-a2d2-bde71b820871

	measure 'Top product sales' = VAR T=TOPN(10,ALLSELECTED(DimProduct[ProductName]),[Sales],DESC) RETURN CALCULATE([Sales L],KEEPFILTERS(T))
		formatString: ₹0.0 "L"
		displayFolder: Report
		lineageTag: d82fd63e-99fd-413e-8f03-2511ecb13dfd

	measure 'Top product INR' = VAR T=TOPN(10,ALLSELECTED(DimProduct[ProductName]),[Sales],DESC) RETURN IF(NOT ISINSCOPE(DimProduct[ProductName])||CONTAINS(T,DimProduct[ProductName],SELECTEDVALUE(DimProduct[ProductName])),[FormatINR])
		formatString: General
		displayFolder: Indian currency
		lineageTag: f69280c6-25fb-4244-a08a-be446b0fdd97

	measure 'Top city sales L' = VAR T=TOPN(5,ALLSELECTED(DimStore[City]),[Sales],DESC) RETURN CALCULATE([Sales L],KEEPFILTERS(T))
		formatString: ₹0.0 "L"
		displayFolder: Report
		lineageTag: 4aab57cf-1913-41ea-8322-55a21310f248

	measure Retention = VAR A=SELECTEDVALUE(CohortAge[Month],0) VAR Cutoff=DATE([Year selected],12,31) VAR Eligible=FILTER(VALUES(DimCustomer[CustomerID]),EDATE(CALCULATE(MIN(DimCustomer[CohortStart])),A)<=Cutoff) VAR D=COUNTROWS(Eligible) VAR N=CALCULATE([Customers],REMOVEFILTERS(DimDate),FactSales[MonthsAfterFirstOrder]=A,KEEPFILTERS(Eligible)) RETURN DIVIDE(N,D)
		formatString: 0%
		displayFolder: Customers coming back
		lineageTag: f56f5c55-dbf9-483c-816b-e0a3b3f289b2

	measure 'Home sentence' = VAR Best=TOPN(1,ALLSELECTED(DimStore[City]),[Sales],DESC) VAR Slow=TOPN(1,ALLSELECTED(DimStore[City]),[Avg delivery time],DESC) RETURN IF(ISBLANK([Sales change]),"Sales: "&[FormatINR]&".","Sales "&IF([Sales change]>=0,"grew ","fell ")&FORMAT(ABS([Sales change]),"0.0%")&" vs last year.")&" Best city: "&CONCATENATEX(Best,DimStore[City])&". Slowest delivery: "&CONCATENATEX(Slow,DimStore[City])&"."
		formatString: General
		displayFolder: Words
		lineageTag: b1bc93b9-6b10-4f46-96d2-f8f89237a565

	measure 'VIP sentence' = VAR VC=CALCULATE([Customers],DimCustomer[Segment]="VIP") VAR VS=CALCULATE([Sales],DimCustomer[Segment]="VIP") RETURN "VIPs: "&FORMAT(DIVIDE(VC,[Customers]),"0%")&" of buyers, "&FORMAT(DIVIDE(VS,[Sales]),"0%")&" of sales"
		formatString: General
		displayFolder: Words
		lineageTag: 6d1cfa5e-a63c-47d0-b543-98152b1c80dc

	measure 'Sales note' = FORMAT([Orders],"#,0")&" orders • sales before returns"
		formatString: General
		displayFolder: Words
		lineageTag: 1f458508-1bb8-4946-ab45-ad1e5784d865

	measure 'Profit note' = "Money left after product costs"
		formatString: General
		displayFolder: Words
		lineageTag: d4b06d5e-18a6-4d0a-ae7e-1919b14a7b0d

	measure 'Orders note' = FORMAT([Customers],"#,0")&" people placed these orders"
		formatString: General
		displayFolder: Words
		lineageTag: 433a3983-61e9-4a1d-ad6b-d19c10cc37b1

	measure 'Delivery note' = FORMAT([Avg delivery time],"0.0")&" min • goal: 22 min or less"
		formatString: General
		displayFolder: Words
		lineageTag: 130111e0-73b8-4714-8d3c-ae88cfe16e63

	measure 'Returns note' = FORMAT([Orders returned],"0.0%")&" of orders were returned"
		formatString: General
		displayFolder: Words
		lineageTag: b75d7e1c-9012-4aa3-94a8-663e7477169e

	measure 'Monthly note' = "This year: teal • last year: grey • "&IF([Metric name]="Orders","thousand orders","₹ lakh")
		formatString: General
		displayFolder: Words
		lineageTag: 54675670-0d0c-4dbb-a955-72df88075384

	measure 'Category note' = "All eight categories • "&IF([Metric name]="Orders","thousand orders","₹ lakh")
		formatString: General
		displayFolder: Words
		lineageTag: d5875f66-ec13-4852-bc5f-067ca8d9fea9

	measure 'Cities note' = "The five cities with the most "&LOWER([Metric name])
		formatString: General
		displayFolder: Words
		lineageTag: 3e196781-4f5a-4f61-801a-ef2acf614db7

	measure 'Retention note' = "First order = 100%. Later months show who came back."
